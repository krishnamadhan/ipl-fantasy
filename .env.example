# IPL Fantasy (ipl11.vercel.app) — environment template (AB-026).
# Copy to .env.local and fill in. NEVER commit real values; .env* are gitignored.
# Real values: Vercel project env + ~/secrets/INDEX.md on the Pi.

# Supabase project (public URL + anon key are exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — full-access key for API routes/cron. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Cricket data feed (live scores)
RAPIDAPI_KEY=

# Claude API — AI features
ANTHROPIC_API_KEY=

# Shared secret protecting Vercel cron endpoints
CRON_SECRET=

# Absolute base URL of the deployment (e.g. https://ipl11.vercel.app)
NEXT_PUBLIC_APP_URL=

# Shared secret + target group for the banteragent fantasy bridge
BOT_SECRET=
BOT_GROUP_ID=
